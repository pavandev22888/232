  "contract": {
    "scope": "Conditional AX guards, argument conversion, explicit unknown-call FSTP32 boundary, single ordered wrap adjustment and final EDI stores. Not the entry/body of 0x414AE770.",
    "inputs": [
      "First AX is observed at 0x414AF113, after the first nested call and saved-word reload. Only its low 16 bits are compared.",
